msgstr "حذف لوگو"

msgid "No product categories found."
msgstr "هیچ دسته‌بندی محصولی پیدا نشد."

msgid "Selected categories and their child categories appear in the restaurant menu."
msgstr "دسته‌بندی‌های انتخاب‌شده و زیر‌دسته‌های آن‌ها در منوی رستوران نمایش داده می‌شوند."

msgid "Select a page"
msgstr "یک برگه انتخاب کنید"

msgid "Select Logo"
msgstr "انتخاب لوگو"

msgid "Use Logo"
msgstr "استفاده از لوگو"

msgid "Configure your restaurant branding, choose WooCommerce categories, and control whether customers can place dine-in or delivery orders."
msgstr "برندینگ رستوران را تنظیم کنید، دسته‌بندی‌های ووکامرس را انتخاب کنید و یک صفحه منوی سریع مبتنی بر ایجکس بسازید."

msgid "Configure your restaurant branding, choose WooCommerce categories, and build a fast AJAX menu page."
msgstr "برندینگ رستوران را تنظیم کنید، دسته‌بندی‌های ووکامرس را انتخاب کنید و یک صفحه منوی سریع مبتنی بر ایجکس بسازید."

msgid "Shortcode"
msgstr "شورت‌کد"

msgid "Use this shortcode on any page, or enable the dedicated menu page below."
msgstr "این شورت‌کد را در هر برگه‌ای استفاده کنید یا صفحه اختصاصی منو را در پایین فعال کنید."

msgid "Shown at the top of the menu page and shortcode output."
msgstr "در بالای صفحه منو و خروجی شورت‌کد نمایش داده می‌شود."

msgid "Optional. Example: yourrestaurant"
msgstr "اختیاری. مثال: yourrestaurant"

msgid "Optional. Displayed in the custom menu sidebar."
msgstr "اختیاری. در سایدبار منوی سفارشی نمایش داده می‌شود."

msgid "Customers can add products to cart and pay through WooCommerce."
msgstr "مشتریان می‌توانند محصولات را به سبد خرید اضافه کرده و از طریق ووکامرس پرداخت کنند."

msgid "Maintain a dedicated WordPress page containing the restaurant menu shortcode."
msgstr "یک برگه اختصاصی وردپرس شامل شورت‌کد منوی رستوران نگهداری شود."

msgid "No logo selected yet."
msgstr "هنوز لوگویی انتخاب نشده است."

msgid "Recommended for the menu header and dedicated restaurant page."
msgstr "برای هدر منو و صفحه اختصاصی رستوران پیشنهاد می‌شود."

