msgstr "پس‌زمینه کارت محصول"

msgid "Product Card Text Color"
msgstr "رنگ متن کارت محصول"

msgid "Used on the custom menu cards in the frontend layout."
msgstr "در کارت‌های منوی سفارشی در نمای کاربری استفاده می‌شود."

msgid "Category Inactive Background"
msgstr "پس‌زمینه دسته‌بندی غیرفعال"

msgid "Category Inactive Text Color"
msgstr "رنگ متن دسته‌بندی غیرفعال"

msgid "Product Name Color"
msgstr "رنگ نام محصول"

msgid "Product Price Color"
msgstr "رنگ قیمت محصول"

msgid "Product Description Color"
msgstr "رنگ توضیحات محصول"

msgid "Woo Resturant Cafe Menu requires WooCommerce to be active."
msgstr "برای استفاده از منوی کافه و رستوران وو، افزونه ووکامرس باید فعال باشد."

msgid "Table Number"
msgstr "شماره میز"

msgid "Enter your table number"
msgstr "شماره میز خود را وارد کنید"

msgid "Order Type"
msgstr "نوع سفارش"

msgid "Dine-in"
msgstr "سرو در رستوران"

msgid "Delivery"
msgstr "ارسال"

msgid "Please enter your table number for dine-in orders."
msgstr "لطفاً برای سفارش‌های سرو در رستوران، شماره میز را وارد کنید."

msgid "first name"
msgstr "نام"

msgid "last name"
msgstr "نام خانوادگی"

msgid "phone number"
msgstr "شماره تلفن"

msgid "address"
msgstr "آدرس"

msgid "city"
msgstr "شهر"

msgid "Please enter your %s for delivery orders."
msgstr "لطفاً %s خود را برای سفارش‌های ارسالی وارد کنید."

msgid "Order Type:"
msgstr "نوع سفارش:"

msgid "Table Number:"
msgstr "شماره میز:"

msgid "Save"
msgstr "ذخیره"

msgid "View-only menu. Ordering is currently disabled."
msgstr "منو فقط برای مشاهده است. سفارش‌گیری در حال حاضر غیرفعال است."

msgid "No menu categories selected yet."
msgstr "هنوز هیچ دسته‌بندی برای منو انتخاب نشده است."

msgid "View Product"
msgstr "مشاهده محصول"

msgid "Displays a WooCommerce-powered restaurant menu with optional ordering, dine-in, and delivery flows."
msgstr "یک منوی رستورانی مبتنی بر ووکامرس با امکان اختیاری سفارش‌گیری، سرو در رستوران و ارسال نمایش می‌دهد."

msgid "Sizes"
msgstr "اندازه‌ها"

msgid "Logo Size"
msgstr "اندازه لوگو"

msgid "Desktop width"
msgstr "عرض در دسکتاپ"

msgid "Desktop height"
msgstr "ارتفاع در دسکتاپ"

msgid "Mobile width"
msgstr "عرض در موبایل"

msgid "Mobile height"
msgstr "ارتفاع در موبایل"

msgid "In pixels. Set a height of 0 to keep the logo proportions automatically."
msgstr "به پیکسل. ارتفاع را ۰ بگذارید تا نسبت ابعاد لوگو به‌صورت خودکار حفظ شود."

msgid "Product Image Height Mode"
msgstr "حالت ارتفاع تصویر محصول"

msgid "Fixed height (crops the image to fit)"
msgstr "ارتفاع ثابت (تصویر برای جا شدن برش می‌خورد)"

msgid "Auto (show the full image, no cropping)"
msgstr "خودکار (نمایش کامل تصویر، بدون برش)"

msgid "Auto sizes every product image to its own proportions, so the whole picture is always visible."
msgstr "در حالت خودکار، ارتفاع هر تصویر متناسب با ابعاد خودش تنظیم می‌شود و کل تصویر همیشه دیده می‌شود."

msgid "Product Image Height"
msgstr "ارتفاع تصویر محصول"

msgid "Desktop"
msgstr "دسکتاپ"

msgid "Mobile"
msgstr "موبایل"

msgid "In pixels. Only used when the height mode is Fixed."
msgstr "به پیکسل. فقط در حالت «ارتفاع ثابت» استفاده می‌شود."
